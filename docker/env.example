####################################
# 🦎 KOMODO DOCKER ENVIRONMENT VARIABLES 🦎 #
####################################

## Copy this file to .env and customize for your deployment
## cp env.example .env

## Timezone
TZ=Etc/UTC

####################################
# CLIENT (AGENT) CONFIGURATION #
####################################

## Configuration paths (files or directories)
KOMODO_CLI_CONFIG_PATHS=/config

## Configuration keywords for matching files
KOMODO_CLI_CONFIG_KEYWORDS=*config.*,*komodo.cli*.*

## Default profile to use
KOMODO_CLI_DEFAULT_PROFILE=Default

## Komodo Core host address
KOMODO_CLI_HOST=https://komodo.example.com

## API credentials (get these from Komodo Core UI)
KOMODO_CLI_KEY=K-...
KOMODO_CLI_SECRET=S-...

## Backups configuration
KOMODO_CLI_BACKUPS_FOLDER=/backups
KOMODO_CLI_MAX_BACKUPS=14

## Source database configuration (for backups)
KOMODO_DATABASE_URI=
KOMODO_DATABASE_ADDRESS=localhost:27017
KOMODO_DATABASE_USERNAME=
KOMODO_DATABASE_PASSWORD=
KOMODO_DATABASE_DB_NAME=komodo

## Target database configuration (for restores)
KOMODO_CLI_DATABASE_TARGET_URI=
KOMODO_CLI_DATABASE_TARGET_ADDRESS=localhost:27017
KOMODO_CLI_DATABASE_TARGET_USERNAME=
KOMODO_CLI_DATABASE_TARGET_PASSWORD=
KOMODO_CLI_DATABASE_TARGET_DB_NAME=komodo

## Client logging
KOMODO_CLI_LOGGING_LEVEL=info
KOMODO_CLI_LOGGING_STDIO=standard
KOMODO_CLI_LOGGING_PRETTY=false

## Client workspace directory (host path)
CLIENT_WORKSPACE=./workspace

####################################
# SERVER (PERIPHERY) CONFIGURATION #
####################################

## Configuration paths
PERIPHERY_CONFIG_PATHS=/config

## Root directory for Periphery operations
## This directory must exist on the host and contain:
##   - stacks/ (for Docker Compose stacks)
##   - repos/ (for Git repositories)
##   - builds/ (for build artifacts)
PERIPHERY_ROOT_DIRECTORY=./komodo-root

## Override specific directories (optional)
# PERIPHERY_REPO_DIR=
# PERIPHERY_STACK_DIR=
# PERIPHERY_BUILD_DIR=

## Authentication - Private key (will be auto-generated if file doesn't exist)
PERIPHERY_PRIVATE_KEY=file:/config/keys/periphery.key

## Authentication - Core public keys (required for outbound mode)
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub

## Outbound mode - Connect to Komodo Core
## If PERIPHERY_CORE_ADDRESS is set, Periphery will connect to Core
PERIPHERY_CORE_ADDRESS=ws://komodo-core:9120
PERIPHERY_CONNECT_AS=server-name
## Onboarding key (only needed for first connection)
# PERIPHERY_ONBOARDING_KEY=

## Inbound mode - Server settings (if not using outbound mode)
# PERIPHERY_SERVER_ENABLED=true
PERIPHERY_PORT=8120
PERIPHERY_BIND_IP=[::]
# PERIPHERY_ALLOWED_IPS=

## SSL/TLS Configuration
PERIPHERY_SSL_ENABLED=true
PERIPHERY_SSL_KEY_FILE=/config/ssl/key.pem
PERIPHERY_SSL_CERT_FILE=/config/ssl/cert.pem

## Terminal settings
PERIPHERY_DEFAULT_TERMINAL_COMMAND=bash
PERIPHERY_DISABLE_TERMINALS=false
PERIPHERY_DISABLE_CONTAINER_TERMINALS=false

## Polling intervals
PERIPHERY_STATS_POLLING_RATE=5-sec
PERIPHERY_CONTAINER_STATS_POLLING_RATE=30-sec

## Docker Compose CLI
PERIPHERY_LEGACY_COMPOSE_CLI=false

## Disk mount filtering
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
# PERIPHERY_EXCLUDE_DISK_MOUNTS=/snap,/etc/repos

## Server logging
PERIPHERY_LOGGING_LEVEL=info
PERIPHERY_LOGGING_STDIO=standard
PERIPHERY_LOGGING_PRETTY=false
PERIPHERY_PRETTY_STARTUP_CONFIG=false
# PERIPHERY_LOGGING_OTLP_ENDPOINT=http://localhost:4317
PERIPHERY_LOGGING_OPENTELEMETRY_SERVICE_NAME=Periphery
PERIPHERY_LOGGING_OPENTELEMETRY_SCOPE_NAME=Komodo

## Server port mapping (host:container)
PERIPHERY_HOST_PORT=8120

####################################
# NETWORK CONFIGURATION #
####################################

## Network name (optional, defaults to komodo-network)
# COMPOSE_PROJECT_NAME=komodo

